{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ncplanner/ncpf": ["packages/ncpf/src/index.ts"],
      "@ncplanner/kernel": ["packages/kernel/src/index.ts"],
      "@ncplanner/formats": ["packages/formats/src/index.ts"],
      "@ncplanner/i18n": ["packages/i18n/src/index.ts"],
      "@ncplanner/generator": ["packages/generator/src/index.ts"],
      "@ncplanner/generator/worker": ["packages/generator/src/worker.ts"],
      "@ncplanner/generator/script": ["packages/generator/src/script.ts"],
      "@ncplanner/app": ["packages/app/src/index.ts"]
    }
  }
}
