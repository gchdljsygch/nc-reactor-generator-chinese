# --- Java-era local artifacts (historical) ------------------------------------
# The Java tree was archived to `java-frozen-<sha>` and removed (java-exit-plan
# §P3/P4), but these rules are kept for stray local files from the frozen build:
# `settings.dat` / `settings.json` (migrate-settings.mjs output) and loose
# `*.ncpf` / `*.config2` saves. The rest of the old Java-only rules (`/out`,
# `/build/`, `/.gradle/`, `/tools/golden/build/`, `/dssl*`, `/version.version`,
# `/benchmark*`, `/errors`, `/crash-reports`, `smorebank.dat`, `special.dat`)
# are gone with the build chain.
/settings.dat
/smorebank.dat
/special.dat
/*.ncpf
/*.ncpf.*
/*.config2
/*.dssl
/*.png
/patrons-list.txt
/*.cfg
/.idea

# --- local build / release artifacts -----------------------------------------
# `release/` holds jpackage output (~560 MB locally) and is NOT a source artifact
/release/

# --- R2/R3 tooling -----------------------------------------------------------
# golden datasets are committed gzipped; the expanded form is 43 MB
/datasets/golden/*.jsonl
# per-run smoke output
/tools/**/out/
# R3: the Vite build is a generated artifact (regenerate with `pnpm build:app`)
/packages/*/dist/
# scratch space for verification probes (blob extractions, Java `-Probe` inputs)
/.tmp-r2/

# --- R1+ TypeScript toolchain -------------------------------------------------
# pnpm store; `pnpm install` recreates it from the committed pnpm-lock.yaml.
# No leading slash: pnpm also creates per-package links (packages/*/node_modules).
node_modules/
# probe scratch under the R0 fixture conversions (never referenced by tests)
/datasets/converted/tmp/

# Loose root-level JSON was the Java app's output format. Only `settings.json`
# (the default output of tools/ts/migrate-settings.mjs) is still expected there.
/*.json
!/package.json
!/tsconfig.json
!/tsconfig.base.json
